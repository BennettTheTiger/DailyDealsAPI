{
  "name": "daily-deals-api",
  "version": "1.0.0",
  "description": "Fastify server that scrapes Guitar Center daily deals and exposes them via JSON API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "npm run build && node --test dist/**/*.test.js",
    "check": "npm run lint && npm run test",
    "scrape": "node dist/cli/scrape.js",
    "scrape:trigger": "npm run build && npm run scrape",
    "export:deals": "npm run build && node dist/cli/export-deals.js"
  },
  "keywords": [
    "fastify",
    "typescript",
    "web-scraping",
    "guitar-center"
  ],
  "author": "Bennett Schoonerman",
  "license": "MIT",
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.2",
    "google-spreadsheet": "^5.3.0",
    "mongodb": "^7.7.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
