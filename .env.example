# Server Configuration
PORT=3000
HOST=0.0.0.0

# Cache Configuration (TTL in seconds)
CACHE_TTL=600

# Enable debug logging
DEBUG=false

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=DealCluster
MONGODB_DB_NAME=daily_deals

# Google Sheets copy configuration
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Discord scrape failure alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
SCRAPE_FAILURE_STATE_FILE=data/scrape-failures.json
